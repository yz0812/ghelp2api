ADMIN_USERNAME=admin
# Run: python -m app.cli init
ADMIN_PASSWORD=
ADMIN_API_KEY=
ENCRYPTION_KEY=
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8000
